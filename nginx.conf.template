server {
    # RailwayなどPaaSは実行時にランダムな$PORTへヘルスチェック/通信するため、
    # 固定の80番ではなく環境変数から決める。ビルド時ではなく起動時にnginx公式イメージの
    # docker-entrypoint.d(envsubst-on-templates)が、このファイルの${PORT}を実際の値に置換する。
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # セキュリティヘッダー
    # ビルド後に確認済み: インラインscript/styleなし、外部接続はSupabase(*.supabase.co)と
    # Yahoo!ショッピングAPI(shoppingapis.jp)、自オリジンの /api/chat のみ。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://shoppingapis.jp; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # カメラ(バーコード読み取り)は自オリジンのみ許可し、それ以外は塞ぐ
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
