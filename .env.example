# このファイルを .env という名前でコピーして、値を入れてください(.env は git に載りません)
#   cp .env.example .env

# Supabase ダッシュボード > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ここに anon public key

# Yahoo!ショッピング商品検索API のアプリケーションID(任意。空でも手入力で使えます)
VITE_YAHOO_APP_ID=

# ---- ここから下はサーバ側(api/・scripts/)用。VITE_ が付かないものはブラウザに埋め込まれません ----
# api/chat.js・api/suggest-product.js が読む(上の VITE_ と同じ値でよい)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=ここに anon public key

# AI提案・チャット用(Anthropic Console で発行)
ANTHROPIC_API_KEY=

# 管理者として扱うメールアドレス(カンマ区切り)
ADMIN_EMAILS=

# 課金(Stripe)用。テストキーから始める
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# 負荷試験(scripts/load-test.mjs)用。強い権限のキーなので取り扱い注意
SUPABASE_SERVICE_ROLE_KEY=
