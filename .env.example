# SupabaseプロジェクトのURLとanonキー
# Supabaseダッシュボード > Project Settings > API から取得してください
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Yahoo!ショッピング商品検索API のアプリケーションID（無料）
# https://e.developer.yahoo.co.jp/register で登録すると取得できます
# JANコードから商品名を自動取得するために使用します（未設定でも手入力で動作します）
VITE_YAHOO_APP_ID=your-yahoo-app-id-here

# --- サーバー専用（VITE_ プレフィックスなし。ブラウザには渡らない） ---

# Claude API（チャット機能 api/chat.js 用）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Stripe（課金 api/checkout.js, api/stripe-webhook.js, api/billing-portal.js 用）
# 必ずテストモードのキーを使う（sk_test_ / whsec_ / price_）
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PRICE_ID=price_xxxxx            # Proプランの月額 recurring Price
STRIPE_WEBHOOK_SECRET=whsec_xxxxx      # `stripe listen` またはダッシュボードのWebhook設定から

# Supabase サーバー側アクセス（Webhookが teams を更新するのに使用）
# Supabaseダッシュボード > Project Settings > API の service_role キー
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 運営用の管理画面(/api/admin-overview)にアクセスできるメールアドレス（カンマ区切り）
ADMIN_EMAILS=you@example.com

# ローカルで Stripe Webhook を試すときだけ 1 にする（本番では設定しない）
# STRIPE_WEBHOOK_SKIP_VERIFY=1
